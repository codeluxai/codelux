{
  "description": "Codelux hooks for Codex. Copy to <repo>/.codex/hooks.json (or ~/.codex/hooks.json) and replace CODELUX_PLUGIN with the absolute path of the folder that holds scripts/. Same scripts as the Claude Code plugin; plain stdout is added as context, exit 2 on acquire blocks the edit with the stderr reason. PreToolUse/PostToolUse on every tool (.*) feed the procedure trace (377). See hooks/OTHER-AGENTS.md for the fields we could not verify.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/session-start.sh\" --agent=codex",
            "timeout": 10,
            "additionalContextLimit": 12500
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/session-track.sh\" start --agent=codex",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/prompt-memory.sh\" --agent=codex",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/session-track.sh\" prompt --agent=codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/edit-lock.sh\" acquire --agent=codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/session-track.sh\" pre --agent=codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/edit-lock.sh\" release --agent=codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/session-track.sh\" post --agent=codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"CODELUX_PLUGIN/scripts/session-track.sh\" stop --agent=codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
